{
  "$schema": "./node_modules/as-test/as-test.config.schema.json",
  "input": ["./assembly/__tests__/*.spec.ts"],
  "outDir": "./.as-test/build",
  "logs": "./.as-test/logs",
  "coverageDir": "./.as-test/coverage",
  "snapshotDir": "./.as-test/snapshots",
  "config": "none",
  "features": ["try-as"],
  "cache": {
    "type": "reachable",
    "ttl": "1d"
  },
  "coverage": {
    "enabled": true,
    "mode": "project",
    "include": ["assembly/**/*.ts"],
    "exclude": [
      "assembly/__tests__/**/*.ts",
      "assembly/__fuzz__/**/*.fuzz.ts",
      "assembly/__bench__/**/*.bench.ts"
    ]
  },
  "buildOptions": {
    "args": [
      "--debug",
      "--disableWarning",
      "217",
      "--disableWarning",
      "228",
      "--disableWarning",
      "235",
      "--disableWarning",
      "906"
    ],
    "target": "wasi"
  },
  "fuzz": {
    "input": ["./assembly/__fuzz__/*.fuzz.ts"],
    "runs": 500,
    "seed": 1337,
    "target": "bindings"
  },
  "runOptions": {
    "runtime": {
      "cmd": "wasmtime <file>"
    }
  },
  "modes": {
    "naive": {
      "env": {
        "JSON_MODE": "NAIVE",
        "JSON_AS_LIBRARY_SOURCE": "assembly/index"
      },
      "buildOptions": {
        "args": [
          "--transform ./",
          "--disableWarning",
          "217",
          "--disableWarning",
          "228",
          "--disableWarning",
          "235",
          "--disableWarning",
          "906"
        ]
      }
    },
    "swar": {
      "env": {
        "JSON_MODE": "SWAR",
        "JSON_AS_LIBRARY_SOURCE": "assembly/index"
      },
      "buildOptions": {
        "args": [
          "--transform ./",
          "--disableWarning",
          "217",
          "--disableWarning",
          "228",
          "--disableWarning",
          "235",
          "--disableWarning",
          "906"
        ]
      }
    },
    "simd": {
      "env": {
        "JSON_MODE": "SIMD",
        "JSON_AS_LIBRARY_SOURCE": "assembly/index"
      },
      "buildOptions": {
        "args": [
          "--debug",
          "--enable simd",
          "--transform ./",
          "--disableWarning",
          "217",
          "--disableWarning",
          "228",
          "--disableWarning",
          "235",
          "--disableWarning",
          "906"
        ]
      }
    }
  }
}
