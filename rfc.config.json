{
  "$schema": "./node_modules/as-test/as-test.config.schema.json",
  "input": [
    "./assembly/__tests__/custom-array.spec.ts",
    "./assembly/__tests__/lazy-metadata.spec.ts",
    "./assembly/__tests__/value-api.spec.ts",
    "./assembly/__tests__/escaped-key-dispatch.spec.ts",
    "./assembly/__tests__/float32-midpoint.spec.ts",
    "./assembly/__tests__/codec-fallback-effects.spec.ts",
    "./assembly/__tests__/dispatch-composition.spec.ts",
    "./assembly/__tests__/value-write-barrier.spec.ts",
    "./assembly/__tests__/custom-buffer-state.spec.ts",
    "./assembly/__tests__/allocation-policy.spec.ts",
    "./assembly/__tests__/nullable-whitespace.spec.ts",
    "./assembly/__tests__/integer-whitespace.spec.ts",
    "./assembly/__tests__/rfc/*.spec.ts",
    "./assembly/__tests__/rfc-matrix/*.spec.ts",
    "./assembly/__tests__/strict/*.spec.ts",
    "./assembly/__tests__/nullable-raw-map.spec.ts",
    "./assembly/__tests__/nullable-set-parse.spec.ts",
    "./assembly/__tests__/nullable-struct-map.spec.ts",
    "./assembly/__tests__/nested-array-boundaries.spec.ts",
    "./assembly/__tests__/generated-field-escapes.spec.ts",
    "./assembly/__tests__/composite-reuse.spec.ts",
    "./assembly/__tests__/date-decoding-reuse.spec.ts",
    "./assembly/__tests__/jsonarray-sort-includes.spec.ts",
    "./assembly/__tests__/jsonarray-reverse-callbacks.spec.ts",
    "./assembly/__tests__/typedarray-view-reuse.spec.ts",
    "./assembly/__tests__/nullable-struct-array.spec.ts",
    "./assembly/__tests__/static-struct-boundaries.spec.ts",
    "./assembly/__tests__/staticarray-gc-reuse.spec.ts"
  ],
  "outDir": "./.as-test/build",
  "logs": "./.as-test/logs",
  "snapshotDir": "./.as-test/snapshots",
  "config": "none",
  "cache": true,
  "coverage": {
    "enabled": false
  },
  "buildOptions": {
    "args": ["--debug"],
    "target": "wasi"
  },
  "runOptions": {
    "runtime": {
      "cmd": "node ./scripts/run-as-test-wasi.mjs <file>"
    }
  },
  "modes": {
    "naive": {
      "env": {
        "JSON_MODE": "NAIVE",
        "JSON_STRICT": "true",
        "JSON_AS_LIBRARY_SOURCE": "assembly/index"
      },
      "buildOptions": {
        "args": ["--transform ./"]
      }
    },
    "swar": {
      "env": {
        "JSON_MODE": "SWAR",
        "JSON_STRICT": "true",
        "JSON_AS_LIBRARY_SOURCE": "assembly/index"
      },
      "buildOptions": {
        "args": ["--transform ./"]
      }
    },
    "simd": {
      "env": {
        "JSON_MODE": "SIMD",
        "JSON_STRICT": "true",
        "JSON_AS_LIBRARY_SOURCE": "assembly/index"
      },
      "buildOptions": {
        "args": ["--debug", "--enable simd", "--transform ./"]
      }
    }
  }
}
